<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景色 -->
    <Color x:Key="BackgroundColor">#FFF7F9FC</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SectionBackgroundColor">#FFF1F4F9</Color>
    <Color x:Key="ControlBackgroundColor">#FFEDF1F7</Color>
    <Color x:Key="EventCardColor">#FFFFFFFF</Color>
    <Color x:Key="WeekendTextColor">#FFC45F63</Color>
    <Color x:Key="HeaderStartColor">#FFF0F1FF</Color>
    <Color x:Key="HeaderEndColor">#FFF8F4FF</Color>

    <!-- 强调色 -->
    <Color x:Key="TodayAccentColor">#FF5B5FEF</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#FF202535</Color>
    <Color x:Key="TextSecondaryColor">#FF70788A</Color>
    <Color x:Key="TextDisabledColor">#FFB7BDCA</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- 分隔与边框 -->
    <Color x:Key="SeparatorColor">#FFE4E8F0</Color>
    <Color x:Key="BorderColor">#FFDCE1EA</Color>

    <!-- 交互状态 -->
    <Color x:Key="HoverColor">#FFEEF0FF</Color>
    <Color x:Key="PressedColor">#FFE1E4FA</Color>
    <Color x:Key="SelectedColor">#FFE8EAFF</Color>

    <!-- 阴影 -->
    <Color x:Key="ShadowColor">#33000000</Color>

    <!-- 事件圆点 -->
    <Color x:Key="EventDotColor">#FF0078D4</Color>

    <!-- 节假日 / 补班角标 -->
    <Color x:Key="RestDayBadgeBackgroundColor">#FFDDEBE0</Color>
    <Color x:Key="RestDayBadgeForegroundColor">#FF2F6840</Color>
    <Color x:Key="WorkdayBadgeBackgroundColor">#FFFFF0B8</Color>
    <Color x:Key="WorkdayBadgeForegroundColor">#FF806000</Color>

    <!-- 画刷（从颜色派生） -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="{StaticResource SectionBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="EventCardBrush" Color="{StaticResource EventCardColor}" />
    <SolidColorBrush x:Key="WeekendTextBrush" Color="{StaticResource WeekendTextColor}" />
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource HeaderStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource HeaderEndColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TodayAccentBrush" Color="{StaticResource TodayAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="EventDotBrush" Color="{StaticResource EventDotColor}" />
    <SolidColorBrush x:Key="RestDayBadgeBackgroundBrush" Color="{StaticResource RestDayBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="RestDayBadgeForegroundBrush" Color="{StaticResource RestDayBadgeForegroundColor}" />
    <SolidColorBrush x:Key="WorkdayBadgeBackgroundBrush" Color="{StaticResource WorkdayBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="WorkdayBadgeForegroundBrush" Color="{StaticResource WorkdayBadgeForegroundColor}" />

</ResourceDictionary>
