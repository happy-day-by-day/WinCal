<Window x:Class="WinCal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="miniCal 设置"
        Icon="/WinCal;component/Assets/WinCal.ico"
        Width="500" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        InputMethod.IsInputMethodEnabled="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface"
                                            Margin="3,1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TodayAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="InputSurface"
                                                MinHeight="36"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Grid Margin="10,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Width="8" Height="5"
                                                      Margin="12,0,0,0"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource TodayAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="240"
                                        Margin="0,4,0,0"
                                        Padding="2"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.25" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TodayAccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource TodayAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TodayAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#FFE26D73" />
            <Setter Property="Foreground" Value="#FFE26D73" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24">
                            <Border x:Name="Track"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12" />
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource TodayAccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TodayAccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TodayAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TodayAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="9">
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid Margin="20,0,13,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                Margin="0,0,12,0"
                                Background="{DynamicResource TodayAccentBrush}"
                                CornerRadius="12"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚙"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="20"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="调整 miniCal 的外观与日历来源"
                                       Margin="0,2,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Click="OnCloseClick"
                                ToolTip="关闭">
                            <Path Data="M5,5 L19,19 M19,5 L5,19"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18,16,18,6">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="8" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="让日历更符合你的阅读习惯"
                                           Margin="0,2,0,14"
                                           Style="{StaticResource HintText}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="颜色主题"
                                               Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              x:Name="ThemeComboBox"
                                              Style="{StaticResource SettingsComboBox}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="跟随系统" />
                                        <ComboBoxItem Content="浅色" />
                                        <ComboBoxItem Content="深色" />
                                    </ComboBox>

                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1"
                                            Margin="0,14" Background="{DynamicResource SeparatorBrush}" />

                                    <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="字体大小" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="FontSizeLabel" Text="标准" Style="{StaticResource HintText}" />
                                    </StackPanel>
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="A" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1" x:Name="FontSizeSlider"
                                                Minimum="-2" Maximum="10" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="A" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>

                                    <Border Grid.Row="3" Grid.ColumnSpan="2"
                                            Margin="0,14,0,0"
                                            Padding="12"
                                            Background="{DynamicResource SectionBackgroundBrush}"
                                            BorderBrush="{DynamicResource SeparatorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="40" Height="48"
                                                    Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource TodayAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PreviewDayText"
                                                               Text="8"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TodayAccentBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="PreviewLunarText"
                                                               Text="廿七"
                                                               Margin="0,-2,0,0"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="PreviewMonthText"
                                                           Text="2026年9月"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="PreviewEventTitle"
                                                           Text="近期日程 · 团队周会"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="PreviewEventTime"
                                                           Text="14:30–15:30"
                                                           Margin="0,1,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Padding="5,2"
                                                        Background="{DynamicResource RestDayBadgeBackgroundBrush}"
                                                        CornerRadius="6">
                                                    <TextBlock Text="休"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource RestDayBadgeForegroundBrush}" />
                                                </Border>
                                                <TextBlock x:Name="FontPreviewScale"
                                                           Text="100%"
                                                           Margin="0,5,0,0"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="开机自启动" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="登录 Windows 后在后台启动 miniCal"
                                               Margin="0,3,0,0" Style="{StaticResource HintText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          x:Name="AutoStartupCheckBox"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="日历与订阅" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选择系统日历、ICS 订阅，或合并显示"
                                           Margin="0,2,0,14" Style="{StaticResource HintText}" />

                                <TextBlock Text="数据源" Margin="0,0,0,7"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DataSourceComboBox"
                                          Style="{StaticResource SettingsComboBox}"
                                          SelectedIndex="0"
                                          SelectionChanged="OnDataSourceChanged">
                                    <ComboBoxItem Content="系统日历" />
                                    <ComboBoxItem Content="ICS 订阅链接" />
                                    <ComboBoxItem Content="两者都用" />
                                </ComboBox>

                                <StackPanel x:Name="IcsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource SectionBackgroundBrush}"
                                            CornerRadius="11" Padding="12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="ICS 订阅" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Text="支持添加多个公开的 .ics 链接"
                                                               Style="{StaticResource HintText}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1"
                                                          x:Name="IcsRefreshCombo"
                                                          Width="106"
                                                          Style="{StaticResource SettingsComboBox}"
                                                          SelectedIndex="1"
                                                          ToolTip="自动刷新频率">
                                                    <ComboBoxItem Content="10 分钟" />
                                                    <ComboBoxItem Content="30 分钟" />
                                                    <ComboBoxItem Content="60 分钟" />
                                                    <ComboBoxItem Content="120 分钟" />
                                                </ComboBox>
                                            </Grid>

                                            <ItemsControl x:Name="IcsUrlList" Margin="0,0,0,3">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource EventCardBrush}"
                                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="10,8"
                                                                Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                                         Fill="{Binding Color}"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,6,8,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding DisplayUrl}"
                                                                               ToolTip="{Binding FullUrl}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource SettingsTextBox}"
                                                                             MinHeight="32"
                                                                             Margin="0,6,0,0"
                                                                             Padding="8,5"
                                                                             ToolTip="订阅显示名称"
                                                                             Tag="{Binding Index}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        Content="×"
                                                                        Width="28" Height="28"
                                                                        Margin="7,0,0,0"
                                                                        Padding="0"
                                                                        Style="{StaticResource IconButton}"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                                        Click="OnRemoveIcsUrl"
                                                                        Tag="{Binding Index}"
                                                                        ToolTip="移除订阅" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         x:Name="NewIcsUrlTextBox"
                                                         Style="{StaticResource SettingsTextBox}"
                                                         ToolTip="输入 .ics 日历订阅链接" />
                                                <Button Grid.Column="1"
                                                        Content="添加订阅"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Click="OnAddIcsUrl" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="日程显示" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="控制近期日程范围和每周的排列方式"
                                           Margin="0,2,0,14" Style="{StaticResource HintText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="近期日程范围" Margin="0,0,0,7"
                                                   Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="UpcomingDaysCombo"
                                                  Style="{StaticResource SettingsComboBox}"
                                                  SelectedIndex="1">
                                            <ComboBoxItem Content="1 天" />
                                            <ComboBoxItem Content="3 天" />
                                            <ComboBoxItem Content="7 天" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="每周开始于" Margin="0,0,0,7"
                                                   Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="WeekStartSunday"
                                                         GroupName="WeekStart"
                                                         Content="周日"
                                                         Style="{StaticResource PillRadio}" />
                                            <RadioButton x:Name="WeekStartMonday"
                                                         GroupName="WeekStart"
                                                         Content="周一"
                                                         Margin="0"
                                                         Style="{StaticResource PillRadio}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="18,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="恢复默认"
                                Margin="0,0,8,0"
                                Style="{StaticResource BaseButton}"
                                Click="OnResetDefaults" />
                        <Button Content="退出程序"
                                Margin="0,0,8,0"
                                Style="{StaticResource DangerButton}"
                                Click="OnExitApp" />
                        <Button Content="保存设置"
                                Padding="19,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnSave" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
