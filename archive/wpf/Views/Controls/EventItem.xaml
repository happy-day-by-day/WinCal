<UserControl x:Class="WinCal.Views.Controls.EventItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="{DynamicResource CalendarEventItemHeight}">

    <Border x:Name="HoverBorder"
            Background="{DynamicResource EventCardBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="2,2,2,2">
        <Grid Margin="10,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="7" Height="7"
                     Fill="{Binding Color}"
                     VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       x:Name="TitleText"
                       FontSize="{DynamicResource CalendarEventTitleFontSize}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <Border Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="7,3"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    CornerRadius="7"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TimeText"
                           FontSize="{DynamicResource CalendarEventMetaFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>
