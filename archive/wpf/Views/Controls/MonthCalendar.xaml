<UserControl x:Class="WinCal.Views.Controls.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinCal.Views.Controls">

    <UserControl.Resources>
        <Style x:Key="RoundNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource CalendarNavigationButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource CalendarNavigationButtonSize}" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource CalendarNavigationFontSize}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodayPillButton" TargetType="Button">
            <Setter Property="Height" Value="{DynamicResource CalendarNavigationButtonSize}" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="{DynamicResource CalendarButtonFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource TodayAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WeekHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource CalendarWeekFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="{DynamicResource CalendarMonthHeaderHeight}" Margin="0,0,0,8"
                Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="14">
            <Grid Margin="15,0,11,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="MonthTitle"
                           Text="{Binding MonthDisplay}"
                           FontSize="{DynamicResource CalendarMonthTitleFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TodayButton" Content="今天" Style="{StaticResource TodayPillButton}" />
                    <Button x:Name="PrevButton" Content="‹" ToolTip="上个月"
                            Style="{StaticResource RoundNavigationButton}" />
                    <Button x:Name="NextButton" Content="›" ToolTip="下个月"
                            Style="{StaticResource RoundNavigationButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="WeekHeaderGrid" Height="{DynamicResource CalendarWeekHeaderHeight}" Margin="3,0,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="H0" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="1" x:Name="H1" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="2" x:Name="H2" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="3" x:Name="H3" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="4" x:Name="H4" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="5" x:Name="H5" Style="{StaticResource WeekHeaderText}" />
            <TextBlock Grid.Column="6" x:Name="H6" Style="{StaticResource WeekHeaderText}" />
        </Grid>

        <ItemsControl Grid.Row="2" x:Name="CalendarGrid" Margin="1,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:DayCell DayData="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
