<Window x:Class="WinCal.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinCal.Views.Controls"
        Title="miniCal"
        Icon="/WinCal;component/Assets/WinCal.ico"
        Width="366"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="True"
        InputMethod.IsInputMethodEnabled="False"
        Topmost="True"
        ResizeMode="NoResize"
        MaxHeight="650">

    <Window.Resources>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource CalendarHeaderActionSize}" />
            <Setter Property="Height" Value="{DynamicResource CalendarHeaderActionSize}" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TodayAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="9">
        <Border x:Name="RootBorder"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <local:MonthCalendar Grid.Row="0"
                                     x:Name="Calendar"
                                     Margin="11,11,11,8" />

                <Border Grid.Row="1"
                        Margin="10,0,10,10"
                        Background="{DynamicResource SectionBackgroundBrush}"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 4 × 42px 事件卡片 + 上下留白，确保第四条完整显示 -->
                            <RowDefinition Height="{DynamicResource CalendarEventListHeight}" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,9,8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="4" Height="{DynamicResource CalendarSectionAccentHeight}"
                                    Margin="0,0,9,0"
                                    Background="{DynamicResource TodayAccentBrush}"
                                    CornerRadius="2" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="近期日程"
                                           FontSize="{DynamicResource CalendarSectionTitleFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="接下来值得关注的安排"
                                           Margin="0,1,0,0"
                                           FontSize="{DynamicResource CalendarSectionHintFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    x:Name="RefreshButton"
                                    Style="{StaticResource HeaderActionButton}"
                                    Click="OnRefreshClick"
                                    ToolTip="刷新日历">
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Button>

                            <Button Grid.Column="3"
                                    x:Name="SettingsButton"
                                    Style="{StaticResource HeaderActionButton}"
                                    Click="OnSettingsClick"
                                    ToolTip="设置">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,13L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,13Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      x:Name="EventScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      PanningMode="VerticalOnly"
                                      PreviewMouseWheel="OnEventListMouseWheel"
                                      Padding="7,0,7,9">
                            <StackPanel>
                                <ItemsControl x:Name="EventListControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:EventItem EventData="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EndMarker"
                                           Text="— 已显示全部 —"
                                           FontSize="{DynamicResource CalendarEndMarkerFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.55"
                                           HorizontalAlignment="Center"
                                           Margin="0,7,0,3"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   x:Name="NoEventsText"
                                   Text="近期没有日程，享受空闲时光"
                                   FontSize="{DynamicResource CalendarButtonFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
